# Service configuration
NODE_ENV=development
GOV_LOG_LEVEL=INFO
GOV_SERVICE_NAME=reporter
PORT=5905

# Internal service URLs
REGISTRY_SERVICE_URL=http://localhost:5902

# Database URIs
MONGO_URI=mongodb://localhost:27017/governify-next

# JWT configuration
SERVICE_AUTHENTICATION_ENABLED=false
JWT_SECRET=governify_next_secret_key

# InfluxDB settings
INFLUX_URL=http://localhost:8181
INFLUX_TOKEN=supersecrettoken
INFLUX_DATABASE=governify-next
INFLUX_WRITE_PRECISION=millisecond
INFLUX_WRITE_BATCH_MAX_POINTS=5000
INFLUX_WRITE_BATCH_MAX_BYTES=8388608
INFLUX_MAX_FAST_RETRIES=5
INFLUX_RETRY_FAST_DELAY_MS=1000
INFLUX_SLOW_RECONNECTION_MAX_RETRIES=10
INFLUX_SLOW_RECONNECTION_STRATEGY=true
INFLUX_RETRY_SLOW_DELAY_MS=10000
INFLUX_HEALTHCHECK_INTERVAL_MS=10000
INFLUX_HEALTHCHECK_TIMEOUT_MS=3000

# Grafana settings
GRAFANA_URL=http://localhost:3000
GRAFANA_PUBLIC_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_INFLUX_URL=http://influxdb3:8181
GRAFANA_DATASOURCE_UID=governify-next-influxdb3
GRAFANA_DATASOURCE_NAME=Governify Next InfluxDB 3
GRAFANA_FOLDER_UID=governify-next
GRAFANA_FOLDER_TITLE=Governify Next
